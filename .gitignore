.vscode/
.vs/
*.user
*.suo
*.sdf
*.opensdf
*.VC.db
*.VC.opendb
.idea/
*.iml
*.ipr
*.iws

# ── Clang tooling artefacts ───────────────────────────────────────────────────
*.clang-tidy-cache

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
.venv/
venv/

# ── OS artefacts ──────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

