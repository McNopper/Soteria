# ── Build directories ─────────────────────────────────────────────────────────
build/
build-*/
out/
_build/
cmake-build-*/

# ── CMake generated files ──────────────────────────────────────────────────────
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
install_manifest.txt
CTestTestfile.cmake
compile_commands.json

# ── Compiled binaries ─────────────────────────────────────────────────────────
*.exe
*.dll
*.pdb
*.lib
*.a
*.so
*.dylib
*.o
*.obj

# ── Pipeline cache artefacts ──────────────────────────────────────────────────
# app/pipeline_src/*.pc.json and *.spv are the offline-compiled source-of-truth.
# pipeline_cache.bin and app/rendering/pipeline_cache_data.hpp are derived but
# committed (so builds do not require the PCC toolchain or Python); regenerate
# the header with tools/generate_pc_header.py when the binary changes.

