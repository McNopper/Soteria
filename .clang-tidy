# .clang-tidy — MISRA C++:2023 aligned static analysis configuration
#
# Scope : engine/ source and headers ONLY.
#         Vulkan SC SDK headers and third-party code are excluded via
#         HeaderFilterRegex and the -isystem include path in CMakeLists.txt.
#
# All checks that fire are treated as errors (WarningsAsErrors: '*').
# Justified suppressions belong in per-file // NOLINT(check-name) comments
# accompanied by a MISRA_DEVIATION() macro — never suppress here globally
# unless the check is genuinely inapplicable to safety-critical embedded C++.
#
# Rule references use MISRA C++:2023 numbering (October 2023), whose section
# numbers follow the ISO/IEC 14882:2017 clause structure:
#   0 Analysis          8 [expr] Expressions        16 [over] Overloading
#   4 [intro] General   9 [stmt] Statements         17 [temp] Templates
#   5 [lex]  Lexical   10 [dcl]  Declarations       18 [except] Exceptions
#   6 [basic] Basics   11 [dcl.decl] Declarators    19 [cpp] Preprocessor
#   7 [conv] Conversions 12 [class] Classes         21..30 Library
#                      13 [class.derived]           15 [special] Special members
#
# One clang-tidy check may enforce several rules; only the closest rule is
# cited per check.

---
Checks: >
  -*,

  # ── 0 Analysis ────────────────────────────────────────────────────────────
  # Rule 0.0.1 (Required): A function shall not contain unreachable statements
  #   — enforced by compiler -Wunreachable-code (part of /W4) and:
  clang-analyzer-deadcode.*,

  # Rule 0.1.2 (Required): The value returned by a function shall be used
  #   — enforced at compile time via [[nodiscard]] + /W4; see also
  #   bugprone-unused-return-value below.
  bugprone-unused-return-value,

  # Rule 0.2.2 (Required): A named function parameter shall be used at least once
  misc-unused-parameters,

  # ── 4 [intro] General ─────────────────────────────────────────────────────
  # Rule 4.1.3 (Required): No undefined or critical unspecified behaviour
  clang-analyzer-core.*,
  clang-analyzer-security.*,
  bugprone-undefined-memory-manipulation,
  bugprone-use-after-move,
  bugprone-dangling-handle,
  bugprone-infinite-loop,

  # Rule 4.6.1 (Required): Operations on a memory location shall be sequenced
  # appropriately — partly enforced by:
  bugprone-suspicious-semicolon,
  misc-redundant-expression,

  # ── 5 [lex] Lexical conventions ───────────────────────────────────────────
  # Rule 5.0.1 (Advisory): Trigraph-like sequences should not be used
  #   — enforced by the compiler (C++17 removed trigraphs).
  # Rule 5.7.1 (Required): No /* within C-style comments — compiler warning.
  # Rule 5.7.3 (Required): No line-splicing in // comments — compiler warning.

  # Rule 5.10.1 (Required): User-defined identifiers shall have an
  # appropriate form
  readability-identifier-naming,

  # ── 6 [basic] Basics ──────────────────────────────────────────────────────
  # Rule 6.2.1 (Required): The one-definition rule shall not be violated
  misc-definitions-in-headers,

  # Rule 6.4.1 (Required): An inner-scope variable shall not hide an
  # outer-scope variable — enforced by compiler -Wshadow (CMakeLists.txt).

  # Rule 6.7.1 (Required): Local variables shall not have static storage
  # duration — no direct check; covered by code review.
  # Rule 6.7.2 (Required): Global variables shall not be used
  cppcoreguidelines-avoid-non-const-global-variables,

  # ── 7 [conv] Standard conversions ─────────────────────────────────────────
  # Rule 7.0.3 (Required): The numerical value of a character shall not be used
  bugprone-signed-char-misuse,

  # Rules 7.0.5/7.0.6 (Required): No signedness-changing promotions or
  # inappropriate numeric assignments
  bugprone-narrowing-conversions,

  # Rule 7.11.2 (Required): An array passed as a function argument shall not
  # decay to a pointer
  cppcoreguidelines-pro-bounds-array-to-pointer-decay,

  # ── 8 [expr] Expressions ──────────────────────────────────────────────────
  # Rule 8.2.2 (Required): C-style casts and functional notation casts shall
  # not be used (exception: cast to void, Rule 0.1.2)
  cppcoreguidelines-pro-type-cstyle-cast,

  # Rule 8.2.3 (Required): A cast shall not remove const/volatile qualification
  cppcoreguidelines-pro-type-const-cast,

  # Rule 8.2.5 (Required): reinterpret_cast shall not be used
  cppcoreguidelines-pro-type-reinterpret-cast,

  # Rule 8.2.10 (Required): Functions shall not call themselves, directly or
  # indirectly (no recursion)
  misc-no-recursion,

  # Rule 8.7.1 (Required): Pointer arithmetic shall not form an invalid pointer
  cppcoreguidelines-pro-bounds-pointer-arithmetic,

  # Rule 8.19.1 (Advisory): The comma operator should not be used
  #   — partly covered by readability-* and compiler warnings.
  readability-redundant-control-flow,
  readability-simplify-boolean-expr,

  # ── 9 [stmt] Statements ───────────────────────────────────────────────────
  # Rule 9.4.1 (Required): All if ... else if constructs shall be terminated
  # with an else — no direct check; covered by code review.
  # Rule 9.4.2 (Required): The structure of a switch statement shall be
  # appropriate — enforced by compiler -Wswitch-enum (CMakeLists.txt) and:
  bugprone-branch-clone,

  # Rule 9.6.1 (Advisory): The goto statement should not be used
  cppcoreguidelines-avoid-goto,

  # ── 10 [dcl] Declarations ─────────────────────────────────────────────────
  # Rule 10.2.1 (Required): An enumeration shall be defined with an explicit
  # underlying type — covered by code review (all engine enums comply).
  modernize-use-using,
  modernize-use-auto,
  modernize-use-default-member-init,

  # ── 11 [dcl.decl] Declarators ─────────────────────────────────────────────
  # Rule 11.3.1 (Advisory): Variables of array type should not be declared
  cppcoreguidelines-avoid-c-arrays,

  # Rule 11.6.1 (Advisory): All variables should be initialized
  cppcoreguidelines-init-variables,

  # ── 13 [class.derived] Derived classes ────────────────────────────────────
  # Rule 13.3.1 (Required): Overriding functions shall use virtual, override
  # or final appropriately
  modernize-use-override,

  # ── 15 [special] Special member functions ─────────────────────────────────
  # Rule 15.0.1 (Required): Special member functions shall be provided
  # appropriately — covered by code review (rule of zero/five applied).
  # Rule 15.1.1 (Required): An object's dynamic type shall not be used from
  # within its constructor or destructor
  clang-analyzer-cplusplus.VirtualCall,
  bugprone-parent-virtual-call,

  # Rule 15.1.3 (Required): Single-argument constructors shall be explicit
  google-explicit-constructor,

  # ── 18 [except] Exception handling ────────────────────────────────────────
  # Exceptions are disabled globally (/EHs-c-); runtime exception rules N/A.
  # Rule 18.4.1 (Required): Exception-unfriendly functions shall be noexcept
  modernize-use-noexcept,

  # ── 19 [cpp] Preprocessing directives ─────────────────────────────────────
  # Rule 19.0.2 (Required): Function-like macros shall not be defined
  cppcoreguidelines-macro-usage,
  cppcoreguidelines-macro-to-enum,
  bugprone-macro-parentheses,
  bugprone-multiple-statement-macro,

  # ── 21 Library: general ───────────────────────────────────────────────────
  # Rule 21.6.1 (Advisory) / 21.6.2 (Required): Dynamic memory should not be
  # used / shall be managed automatically
  cppcoreguidelines-no-malloc,
  misc-new-delete-overloads,
  misc-uniqueptr-reset-release,

  # Rule 21.10.1 (Required): The features of <cstdarg> shall not be used
  cppcoreguidelines-pro-type-vararg,

  # Rule 21.10.2 (Required): The standard header <csetjmp> shall not be used
  cert-err52-cpp,

  # ── 28 Library: utilities ─────────────────────────────────────────────────
  # Rule 28.6.1/28.6.3 (Required): Correct use of std::move / moved-from state
  bugprone-move-forwarding-reference,
  performance-move-const-arg,
  performance-no-automatic-move,
  clang-analyzer-cplusplus.Move,

  # ── General best practices (support the rules above) ──────────────────────
  bugprone-assert-side-effect,
  bugprone-bool-pointer-implicit-conversion,
  bugprone-copy-constructor-init,
  bugprone-exception-escape,
  bugprone-fold-init-type,
  bugprone-implicit-widening-of-multiplication-result,
  bugprone-incorrect-roundings,
  bugprone-integer-division,
  bugprone-misplaced-operator-in-strlen-in-alloc,
  bugprone-misplaced-widening-cast,
  bugprone-posix-return,
  bugprone-sizeof-container,
  bugprone-sizeof-expression,
  bugprone-string-constructor,
  bugprone-string-integer-assignment,
  bugprone-string-literal-with-embedded-nul,
  bugprone-suspicious-enum-usage,
  bugprone-suspicious-memory-comparison,
  bugprone-suspicious-missing-comma,
  bugprone-swapped-arguments,
  bugprone-throw-keyword-missing,
  bugprone-too-small-loop-variable,
  bugprone-unhandled-exception-at-new,
  bugprone-unhandled-self-assignment,
  bugprone-virtual-near-miss,
  performance-for-range-copy,
  performance-implicit-conversion-in-loop,
  performance-inefficient-algorithm,
  performance-inefficient-string-concatenation,
  performance-move-constructor-init,
  performance-trivially-destructible,
  performance-type-promotion-in-math-fn,
  performance-unnecessary-copy-initialization,
  performance-unnecessary-value-param,
  portability-simd-intrinsics,
  misc-misplaced-const,
  misc-non-private-member-variables-in-classes,
  misc-static-assert,
  misc-throw-by-value-catch-by-reference,
  misc-unconventional-assign-operator,
  misc-unused-alias-decls,
  misc-unused-using-decls,
  readability-avoid-const-params-in-decls,
  readability-const-return-type,
  readability-container-size-empty,
  readability-else-after-return,
  readability-make-member-function-const,
  readability-non-const-parameter,
  readability-qualified-auto,
  readability-redundant-access-specifiers,
  readability-redundant-preprocessor,
  readability-static-accessed-through-instance,
  readability-static-definition-in-anonymous-namespace,
  readability-string-compare,
  readability-use-anyofallof,
  modernize-use-nullptr

WarningsAsErrors: '*'

# Only analyse engine source files; exclude SDK headers and third-party libs.
# Matches headers under engine/(core|data|rendering|wsi) regardless of install path.
HeaderFilterRegex: '.*(engine)[/\\](core|data|rendering|wsi)[/\\].*'

# System include paths excluded from analysis (Vulkan SC SDK, Windows SDK).
SystemHeaders: false

CheckOptions:
  # ── readability-identifier-naming ────────────────────────────────────────
  # MISRA C++:2023 Rule 5.10.1 — identifiers must be meaningful and distinct.
  # Naming convention: CamelCase for types/classes; m_ prefix for members;
  # k prefix for compile-time constants; all-caps for macros only.
  - key:   readability-identifier-naming.ClassCase
    value: CamelCase
  - key:   readability-identifier-naming.StructCase
    value: CamelCase
  - key:   readability-identifier-naming.EnumCase
    value: CamelCase
  - key:   readability-identifier-naming.EnumConstantCase
    value: CamelCase
  - key:   readability-identifier-naming.EnumConstantPrefix
    value: 'e'
  - key:   readability-identifier-naming.FunctionCase
    value: CamelCase
  - key:   readability-identifier-naming.MemberCase
    value: camelBack
  - key:   readability-identifier-naming.MemberPrefix
    value: 'm_'
  - key:   readability-identifier-naming.ConstantMemberCase
    value: CamelCase
  - key:   readability-identifier-naming.ConstantMemberPrefix
    value: 'k'
  - key:   readability-identifier-naming.StaticConstantCase
    value: CamelCase
  - key:   readability-identifier-naming.StaticConstantPrefix
    value: 'k'
  - key:   readability-identifier-naming.ParameterCase
    value: camelBack
  - key:   readability-identifier-naming.LocalVariableCase
    value: camelBack
  - key:   readability-identifier-naming.NamespaceCase
    value: lower_case
  - key:   readability-identifier-naming.MacroDefinitionCase
    value: UPPER_CASE

  # ── misc-non-private-member-variables-in-classes ─────────────────────────
  # Allow struct-style aggregates with all-public data (e.g. VkscContextConfig)
  - key:   misc-non-private-member-variables-in-classes.IgnoreClassesWithAllMemberVariablesBeingPublic
    value: '1'
